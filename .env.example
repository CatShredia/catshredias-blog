# PostgreSQL (local docker: port 55433)
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/portfolio_db"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed (npm run db:seed)
ADMIN_EMAIL="admin@catshredia.ru"
ADMIN_PASSWORD="changeme"

# OAuth (optional, stage 3+)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Cloudflare Turnstile (comments)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Cron: POST /api/cron/publish-scheduled
# CRON_SECRET=

# Uploads directory (default: ./uploads)
# UPLOAD_DIR=./uploads
