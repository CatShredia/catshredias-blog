# /etc/nginx/sites-available/runews.catshredia.ru
# Проксирует в Docker runews-web (127.0.0.1:8080).

server {
    listen 80;
    server_name runews.catshredia.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name runews.catshredia.ru;

    ssl_certificate     /etc/letsencrypt/live/runews.catshredia.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runews.catshredia.ru/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass http://127.0.0.1:8080/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
